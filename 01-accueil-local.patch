+import moe.rukamori.archivetune.db.entities.Artist
+import moe.rukamori.archivetune.db.entities.Playlist
+import moe.rukamori.archivetune.db.entities.PlaylistEntity
+import moe.rukamori.archivetune.db.entities.PlaylistSongMap
+import moe.rukamori.archivetune.db.entities.Song
+import moe.rukamori.archivetune.localmedia.LocalSongScanConfig
+import moe.rukamori.archivetune.localmedia.ScanLocalMusicUseCase
+import moe.rukamori.archivetune.utils.reportException
+import java.time.LocalDateTime
+import java.time.ZoneOffset
+import javax.inject.Inject
+import kotlin.random.Random
+
+/** Une sélection de morceaux de la bibliothèque locale, générée sans IA. */
+@Immutable
+data class LocalMix(
+    val id: String,
+    val title: String,
+    val subtitle: String,
+    val songs: List<Song>,
+)
+
+@HiltViewModel
+class LocalHomeViewModel
+    @Inject
+    constructor(
+        private val database: MusicDatabase,
+        private val scanLocalMusic: ScanLocalMusicUseCase,
+    ) : ViewModel() {
+        private val _scanState = MutableStateFlow<LocalSongsScanState>(LocalSongsScanState.Empty)
+        val scanState = _scanState.asStateFlow()
+        private var scanJob: Job? = null
+
+        val localSongs: StateFlow<List<Song>> =
+            database
+                .localSongs()
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val recentlyAdded: StateFlow<List<Song>> =
+            database
+                .localSongs()
+                .map { songs ->
+                    songs.sortedByDescending { it.song.dateModified.toEpochMillis() }.take(HOME_ROW_SIZE)
+                }.flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val recentlyPlayed: StateFlow<List<Song>> =
+            database
+                .recentSongs(limit = RECENT_QUERY_LIMIT)
+                .map { songs -> songs.filter { it.song.isLocal }.take(HOME_ROW_SIZE) }
+                .flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val mostPlayed: StateFlow<List<Song>> =
+            database
+                .mostPlayedSongs(fromTimeStamp = 0L, limit = RECENT_QUERY_LIMIT, toTimeStamp = Long.MAX_VALUE)
+                .map { songs -> songs.filter { it.song.isLocal }.take(HOME_ROW_SIZE) }
+                .flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val liked: StateFlow<List<Song>> =
+            database
+                .likedSongsByCreateDateAsc()
+                .map { songs -> songs.filter { it.song.isLocal }.reversed().take(HOME_ROW_SIZE) }
+                .flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val albums: StateFlow<List<Album>> =
+            database
+                .albumsByNameAsc()
+                .map { it.take(ALBUM_ARTIST_ROW_SIZE) }
+                .flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val artists: StateFlow<List<Artist>> =
+            database
+                .artistsByNameAsc()
+                .map { it.take(ALBUM_ARTIST_ROW_SIZE) }
+                .flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        val playlists: StateFlow<List<Playlist>> =
+            database
+                .playlistsByCreateDateAsc()
+                .map { list -> list.filter { it.playlist.browseId == null && !it.playlist.isHidden }.reversed() }
+                .flowOn(Dispatchers.Default)
+                .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+        private val _mixes = MutableStateFlow<List<LocalMix>>(emptyList())
+
+        /** Mixes recalculés à chaque ouverture de l'appli et à la demande (bouton Rafraîchir). */
+        val mixes: StateFlow<List<LocalMix>> = _mixes.asStateFlow()
+
+        init {
+            refreshMixes()
+        }
+
+        fun scanDevice(scanConfig: LocalSongScanConfig = LocalSongScanConfig()) {
+            if (scanJob?.isActive == true) return
+            _scanState.value = LocalSongsScanState.Loading
+            scanJob =
+                viewModelScope.launch {
+                    try {
+                        _scanState.value = LocalSongsScanState.Success(scanLocalMusic(scanConfig))
+                        refreshMixes()
+                    } catch (cancelled: CancellationException) {
+                        _scanState.value = LocalSongsScanState.Empty
+                        throw cancelled
+                    } catch (error: Exception) {
+                        reportException(error)
+                        _scanState.value = LocalSongsScanState.Error(moe.rukamori.archivetune.R.string.local_songs_scan_failed)
+                    }
+                }
+        }
+
+        fun refreshMixes() {
+            viewModelScope.launch {
+                val generated =
+                    withContext(Dispatchers.Default) {
+                        val songs = database.localSongs().first()
+                        val played =
+                            database
+                                .mostPlayedSongs(fromTimeStamp = 0L, limit = RECENT_QUERY_LIMIT, toTimeStamp = Long.MAX_VALUE)
+                                .first()
+                                .filter { it.song.isLocal }
+                        val favorites = database.likedSongsByCreateDateAsc().first().filter { it.song.isLocal }
+                        buildMixes(
+                            songs = songs,
+                            mostPlayed = played,
+                            favorites = favorites,
+                            random = Random(System.nanoTime()),
+                        )
+                    }
+                _mixes.value = generated
+            }
+        }
+
+        /** Enregistre un mix comme vraie playlist locale. Retourne true en cas de succès. */
+        suspend fun saveMixAsPlaylist(mix: LocalMix): Boolean =
+            withContext(Dispatchers.IO) {
+                try {
+                    val playlist =
+                        PlaylistEntity(
+                            name = mix.title,
+                            bookmarkedAt = LocalDateTime.now(),
+                            isEditable = true,
+                        )
+                    database.withTransaction {
+                        insert(playlist)
+                        mix.songs.forEachIndexed { index, song ->
+                            insert(PlaylistSongMap(playlistId = playlist.id, songId = song.id, position = index))
+                        }
+                    }
+                    true
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (error: Exception) {
+                    reportException(error)
+                    false
+                }
+            }
+
+        private fun buildMixes(
+            songs: List<Song>,
+            mostPlayed: List<Song>,
+            favorites: List<Song>,
+            random: Random,
+        ): List<LocalMix> {
+            if (songs.isEmpty()) return emptyList()
+            val mixes = mutableListOf<LocalMix>()
+
+            fun add(
+                id: String,
+                title: String,
+                subtitle: String,
+                pool: List<Song>,
+                minimum: Int = MIN_MIX_SIZE,
+            ) {
+                if (pool.size >= minimum) {
+                    mixes += LocalMix(id, title, subtitle, pool.shuffled(random).take(MIX_SIZE))
+                }
+            }
+
+            add("random", "Mix aléatoire", "Toute ta bibliothèque", songs, minimum = 1)
+
+            val unplayed = songs.filter { it.song.totalPlayTime <= 0L }
+            val rediscover =
+                if (unplayed.size >= MIN_MIX_SIZE) {
+                    unplayed
+                } else {
+                    songs.sortedBy { it.song.totalPlayTime }.take(REDISCOVER_FALLBACK_SIZE)
+                }
+            add("rediscover", "Redécouverte", "Rarement ou jamais écoutés", rediscover)
+
+            val topArtist =
+                mostPlayed
+                    .flatMap { it.artists }
+                    .filter { it.name.isNotBlank() }
+                    .groupingBy { it.id }
+                    .eachCount()
+                    .maxByOrNull { it.value }
+                    ?.key
+            if (topArtist != null) {
+                val artistName = mostPlayed.flatMap { it.artists }.firstOrNull { it.id == topArtist }?.name.orEmpty()
+                add(
+                    id = "artist_$topArtist",
+                    title = "Autour de $artistName",
+                    subtitle = "Ton artiste du moment",
+                    pool = songs.filter { song -> song.artists.any { it.id == topArtist } },
+                )
+            }
+
+            val decades =
+                songs
+                    .mapNotNull { song -> song.song.year?.takeIf { it in MIN_YEAR..MAX_YEAR }?.let { (it / 10) * 10 to song } }
+                    .groupBy({ it.first }, { it.second })
+                    .filter { it.value.size >= MIN_MIX_SIZE }
+            decades.keys.shuffled(random).take(MAX_DECADE_MIXES).forEach { decade ->
+                add("decade_$decade", "Années $decade", "Musique de l'époque", decades.getValue(decade))
+            }
+
+            add("favorites", "Mix Favoris", "Tes titres aimés", favorites)
+
+            return mixes
+        }
+
+        private fun LocalDateTime?.toEpochMillis(): Long = this?.toInstant(ZoneOffset.UTC)?.toEpochMilli() ?: 0L
+
+        private companion object {
+            const val HOME_ROW_SIZE = 20
+            const val ALBUM_ARTIST_ROW_SIZE = 50
+            const val RECENT_QUERY_LIMIT = 60
+            const val MIX_SIZE = 40
+            const val MIN_MIX_SIZE = 8
+            const val REDISCOVER_FALLBACK_SIZE = 100
+            const val MIN_YEAR = 1900
+            const val MAX_YEAR = 2100
+            const val MAX_DECADE_MIXES = 2
+        }
+    }
