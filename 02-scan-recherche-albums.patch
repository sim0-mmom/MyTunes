+/**
+ * Onglet Recherche en mode local : la recherche porte uniquement sur la bibliothèque
+ * (titres, albums, artistes, playlists). Plus aucune découverte YouTube Music.
+ */
+@Composable
+fun LocalSearchHomeScreen(
+    navController: NavController,
+    onSearchClick: () -> Unit,
+    headerScrollConnection: NestedScrollConnection? = null,
+) {
+    val openLibrary = rememberLibraryTabOpener(navController)
+
+    LazyColumn(
+        modifier =
+            Modifier
+                .fillMaxSize()
+                .then(
+                    if (headerScrollConnection != null) {
+                        Modifier.nestedScroll(headerScrollConnection)
+                    } else {
+                        Modifier
+                    },
+                ),
+        contentPadding = LocalPlayerAwareWindowInsets.current.asPaddingValues(),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        item(key = "search_field") {
+            Surface(
+                onClick = onSearchClick,
+                shape = RoundedCornerShape(28.dp),
+                color = MaterialTheme.colorScheme.surfaceContainerHigh,
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+            ) {
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    modifier = Modifier.padding(horizontal = 20.dp, vertical = 16.dp),
+                ) {
+                    Icon(painter = painterResource(R.drawable.search), contentDescription = null)
+                    Spacer(Modifier.width(12.dp))
+                    Text(
+                        text = "Rechercher dans ta bibliothèque",
+                        style = MaterialTheme.typography.bodyLarge,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            }
+        }
+
+        item(key = "browse_title") {
+            Text(
+                text = "Parcourir",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.SemiBold,
+                modifier = Modifier.padding(horizontal = 16.dp),
+            )
+        }
+
+        item(key = "browse_songs") {
+            BrowseRow(
+                label = "Tous les titres",
+                iconRes = R.drawable.music_note,
+                onClick = { navController.navigate("local_songs") },
+            )
+        }
+        item(key = "browse_albums") {
+            BrowseRow(
+                label = "Albums",
+                iconRes = R.drawable.album,
+                onClick = { openLibrary(LibraryFilter.ALBUMS) },
+            )
+        }
+        item(key = "browse_artists") {
+            BrowseRow(
+                label = "Artistes",
+                iconRes = R.drawable.artist,
+                onClick = { openLibrary(LibraryFilter.ARTISTS) },
+            )
+        }
+        item(key = "browse_playlists") {
+            BrowseRow(
+                label = "Playlists",
+                iconRes = R.drawable.queue_music,
+                onClick = { openLibrary(LibraryFilter.PLAYLISTS) },
+            )
+        }
+        item(key = "bottom_spacer") { Spacer(Modifier.height(24.dp)) }
+    }
+}
+
+@Composable
+private fun BrowseRow(
+    label: String,
+    iconRes: Int,
+    onClick: () -> Unit,
+) {
+    Surface(
+        onClick = onClick,
+        shape = RoundedCornerShape(20.dp),
+        color = MaterialTheme.colorScheme.secondaryContainer,
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.padding(horizontal = 20.dp, vertical = 18.dp),
+        ) {
+            Icon(
+                painter = painterResource(iconRes),
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.onSecondaryContainer,
+            )
+            Spacer(Modifier.width(16.dp))
+            Column {
+                Text(
+                    text = label,
+                    style = MaterialTheme.typography.titleMedium,
+                    color = MaterialTheme.colorScheme.onSecondaryContainer,
+                )
+            }
+        }
+    }
+}
